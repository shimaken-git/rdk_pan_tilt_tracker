#!/usr/bin/env python3

from typing import Optional, Tuple

import cv2
import numpy as np

import rclpy
from rclpy.node import Node

from dynamixel_handler_msgs.msg import DynamixelControlXPosition

from ultralytics import YOLO


class PanTiltTracker(Node):

    def __init__(self):
        super().__init__('pan_tilt_tracker')

        # ============================================================
        # Parameters
        # ============================================================

        self.declare_parameter('camera_id', 0)
        self.declare_parameter(
            'model',
            'yolo11n-pose.pt'
        )

        self.declare_parameter('image_width', 1280)
        self.declare_parameter('image_height', 720)

        # Dynamixel ID
        self.declare_parameter('pan_id', 1)
        self.declare_parameter('tilt_id', 2)

        # Initial angle
        self.declare_parameter('pan_initial', 0.0)
        self.declare_parameter('tilt_initial', 0.0)

        # Motor direction
        self.declare_parameter('pan_direction', 1.0)
        self.declare_parameter('tilt_direction', 1.0)

        # Angle limits
        self.declare_parameter('pan_min', -90.0)
        self.declare_parameter('pan_max', 90.0)

        self.declare_parameter('tilt_min', -45.0)
        self.declare_parameter('tilt_max', 45.0)

        # P gain
        self.declare_parameter('pan_kp', 0.035)
        self.declare_parameter('tilt_kp', 0.035)

        # Maximum movement per frame
        self.declare_parameter('max_pan_step', 1.0)
        self.declare_parameter('max_tilt_step', 1.0)

        # Dead zone
        self.declare_parameter('deadzone_x', 30.0)
        self.declare_parameter('deadzone_y', 30.0)

        # EMA
        self.declare_parameter('filter_alpha', 0.25)

        # YOLO
        self.declare_parameter('confidence', 0.5)

        # ============================================================
        # Read parameters
        # ============================================================

        self.camera_id = self.get_parameter(
            'camera_id'
        ).value

        self.model_path = self.get_parameter(
            'model'
        ).value

        self.image_width = self.get_parameter(
            'image_width'
        ).value

        self.image_height = self.get_parameter(
            'image_height'
        ).value

        self.pan_id = self.get_parameter(
            'pan_id'
        ).value

        self.tilt_id = self.get_parameter(
            'tilt_id'
        ).value

        self.pan_angle = self.get_parameter(
            'pan_initial'
        ).value

        self.tilt_angle = self.get_parameter(
            'tilt_initial'
        ).value

        self.pan_direction = self.get_parameter(
            'pan_direction'
        ).value

        self.tilt_direction = self.get_parameter(
            'tilt_direction'
        ).value

        self.pan_min = self.get_parameter(
            'pan_min'
        ).value

        self.pan_max = self.get_parameter(
            'pan_max'
        ).value

        self.tilt_min = self.get_parameter(
            'tilt_min'
        ).value

        self.tilt_max = self.get_parameter(
            'tilt_max'
        ).value

        self.pan_kp = self.get_parameter(
            'pan_kp'
        ).value

        self.tilt_kp = self.get_parameter(
            'tilt_kp'
        ).value

        self.max_pan_step = self.get_parameter(
            'max_pan_step'
        ).value

        self.max_tilt_step = self.get_parameter(
            'max_tilt_step'
        ).value

        self.deadzone_x = self.get_parameter(
            'deadzone_x'
        ).value

        self.deadzone_y = self.get_parameter(
            'deadzone_y'
        ).value

        self.alpha = self.get_parameter(
            'filter_alpha'
        ).value

        self.confidence = self.get_parameter(
            'confidence'
        ).value

        # ============================================================
        # YOLO
        # ============================================================

        self.get_logger().info(
            f'Loading YOLO model: {self.model_path}'
        )

        self.model = YOLO(self.model_path)

        # ============================================================
        # Camera
        # ============================================================

        self.cap = cv2.VideoCapture(self.camera_id)

        if not self.cap.isOpened():
            raise RuntimeError(
                f'Cannot open camera {self.camera_id}'
            )

        self.cap.set(
            cv2.CAP_PROP_FRAME_WIDTH,
            self.image_width
        )

        self.cap.set(
            cv2.CAP_PROP_FRAME_HEIGHT,
            self.image_height
        )

        # ============================================================
        # Dynamixel publishers
        # ============================================================

        self.position_pub = self.create_publisher(
            DynamixelControlXPosition,
            '/dynamixel/command/x/position_control',
            10
        )

        # ============================================================
        # Tracking state
        # ============================================================

        self.filtered_x: Optional[float] = None
        self.filtered_y: Optional[float] = None

        self.target_type = 'none'

        # ============================================================
        # Timer
        # ============================================================

        self.timer = self.create_timer(
            1.0 / 30.0,
            self.update
        )

        self.get_logger().info(
            'Pan Tilt Tracker started'
        )

    # =================================================================
    # Main update
    # =================================================================

    def update(self):

        ret, frame = self.cap.read()

        if not ret:
            self.get_logger().warning(
                'Failed to read camera frame'
            )
            return

        height, width = frame.shape[:2]

        # ------------------------------------------------------------
        # Stereo image
        #
        # [ Left Camera | Right Camera ]
        # ------------------------------------------------------------

        half_width = width // 2

        left_frame = frame[:, :half_width]
        right_frame = frame[:, half_width:]

        left_height, left_width = left_frame.shape[:2]

        left_center_x = left_width / 2.0
        left_center_y = left_height / 2.0

        right_center_x = right_frame.shape[1] / 2.0
        right_center_y = right_frame.shape[0] / 2.0

        # ------------------------------------------------------------
        # YOLO - Left
        # ------------------------------------------------------------

        left_results = self.model(
            left_frame,
            conf=self.confidence,
            verbose=False
        )

        left_target = self.find_target(
            left_results,
            left_width,
            left_height
        )

        # ------------------------------------------------------------
        # YOLO - Right
        # ------------------------------------------------------------

        right_results = self.model(
            right_frame,
            conf=self.confidence,
            verbose=False
        )

        right_target = self.find_target(
            right_results,
            right_frame.shape[1],
            right_frame.shape[0]
        )

        # ============================================================
        # Target selection for Pan / Tilt
        #
        # Both left and right cameras must detect the same target type.
        # ============================================================

        tracking_target = None

        if (
            left_target is not None
            and right_target is not None
        ):

            left_x, left_y, left_type = left_target
            right_x, right_y, right_type = right_target

            # --------------------------------------------------------
            # Make sure both cameras detected the same target type
            # --------------------------------------------------------

            if left_type == right_type:

                # ----------------------------------------------------
                # Target type
                # ----------------------------------------------------

                self.target_type = left_type

                # ----------------------------------------------------
                # Average target position
                #
                # Both images have the same resolution.
                # Therefore, average the image errors.
                # ----------------------------------------------------

                target_x = (
                    left_x + right_x
                ) / 2.0

                target_y = (
                    left_y + right_y
                ) / 2.0

                tracking_target = (
                    target_x,
                    target_y,
                    left_type
                )

        # ============================================================
        # Tracking
        # ============================================================

        if tracking_target is not None:

            target_x, target_y, target_type = tracking_target

            # --------------------------------------------------------
            # EMA filter
            # --------------------------------------------------------

            if self.filtered_x is None:

                self.filtered_x = target_x
                self.filtered_y = target_y

            else:

                self.filtered_x = (
                    self.alpha * target_x
                    +
                    (1.0 - self.alpha) * self.filtered_x
                )

                self.filtered_y = (
                    self.alpha * target_y
                    +
                    (1.0 - self.alpha) * self.filtered_y
                )

            # --------------------------------------------------------
            # Error
            #
            # Use the center of ONE camera image.
            # left_center_x / right_center_x are the same
            # if the stereo images have the same resolution.
            # --------------------------------------------------------

            error_x = (
                self.filtered_x - left_center_x
            )

            error_y = (
                self.filtered_y - left_center_y
            )

            # --------------------------------------------------------
            # Dead zone
            # --------------------------------------------------------

            if abs(error_x) < self.deadzone_x:
                error_x = 0.0

            if abs(error_y) < self.deadzone_y:
                error_y = 0.0

            # --------------------------------------------------------
            # Pan
            # --------------------------------------------------------

            pan_delta = (
                self.pan_direction
                *
                self.pan_kp
                *
                error_x
            )

            pan_delta = np.clip(
                pan_delta,
                -self.max_pan_step,
                self.max_pan_step
            )

            self.pan_angle += pan_delta

            self.pan_angle = float(
                np.clip(
                    self.pan_angle,
                    self.pan_min,
                    self.pan_max
                )
            )

            # --------------------------------------------------------
            # Tilt
            # --------------------------------------------------------

            tilt_delta = (
                self.tilt_direction
                *
                self.tilt_kp
                *
                error_y
            )

            tilt_delta = np.clip(
                tilt_delta,
                -self.max_tilt_step,
                self.max_tilt_step
            )

            self.tilt_angle += tilt_delta

            self.tilt_angle = float(
                np.clip(
                    self.tilt_angle,
                    self.tilt_min,
                    self.tilt_max
                )
            )

            # --------------------------------------------------------
            # Publish Dynamixel position
            # --------------------------------------------------------

            self.publish_position()

        else:

            self.target_type = 'none'

        # ============================================================
        # Draw
        # ============================================================

        self.draw_debug(
            left_frame,
            left_center_x,
            left_center_y,
            left_target
        )

        self.draw_debug(
            right_frame,
            right_center_x,
            right_center_y,
            right_target
        )

        # ============================================================
        # Combine left and right images
        # ============================================================

        frame = np.hstack(
            (
                left_frame,
                right_frame
            )
        )

        # ============================================================
        # Display
        # ============================================================

        cv2.imshow(
            'Pan Tilt Tracker',
            frame
        )

        key = cv2.waitKey(1)

        if key == 27:
            rclpy.shutdown()

    # =================================================================
    # Target selection
    # =================================================================

    def find_target(self, results, width, height):

        face_target = None
        hand_target = None

        # ------------------------------------------------------------
        # Process YOLO results
        # ------------------------------------------------------------

        for result in results:

            if result.keypoints is None:
                continue

            keypoints = result.keypoints.data.cpu().numpy()

            # --------------------------------------------------------
            # Each detected person
            # --------------------------------------------------------

            for person in keypoints:

                # ====================================================
                # Face
                #
                # COCO keypoints:
                # 0 = nose
                # 1 = left eye
                # 2 = right eye
                # 3 = left ear
                # 4 = right ear
                # ====================================================

                face_points = []

                for idx in [0, 1, 2, 3, 4]:

                    x = person[idx][0]
                    y = person[idx][1]
                    conf = person[idx][2]

                    if conf > 0.3:

                        face_points.append(
                            (float(x), float(y))
                        )

                # ----------------------------------------------------
                # Calculate face center
                # ----------------------------------------------------

                if len(face_points) > 0:

                    face_x = sum(
                        p[0] for p in face_points
                    ) / len(face_points)

                    face_y = sum(
                        p[1] for p in face_points
                    ) / len(face_points)

                    face_target = (
                        face_x,
                        face_y
                    )

                # ====================================================
                # Left wrist
                # ====================================================

                left_wrist = person[9]

                if left_wrist[2] > 0.3:

                    hand_target = (
                        float(left_wrist[0]),
                        float(left_wrist[1])
                    )

                # ====================================================
                # Right wrist
                # ====================================================

                right_wrist = person[10]

                if right_wrist[2] > 0.3:

                    hand_target = (
                        float(right_wrist[0]),
                        float(right_wrist[1])
                    )

        # ============================================================
        # Target selection
        #
        # Face has priority over hand
        # ============================================================

        if face_target is not None:

            return (
                face_target[0],
                face_target[1],
                'face'
            )

        if hand_target is not None:

            return (
                hand_target[0],
                hand_target[1],
                'hand'
            )

        return None
    
    # =================================================================
    # Dynamixel command
    # =================================================================

    def publish_position(self):

        msg = DynamixelControlXPosition()

        msg.id_list = [
            self.pan_id,
            self.tilt_id
        ]

        msg.position_deg = [
            float(self.pan_angle),
            float(self.tilt_angle)
        ]

        msg.profile_vel_deg_s = []
        msg.profile_acc_deg_ss = []

        self.position_pub.publish(msg)

    # =================================================================
    # Debug display
    # =================================================================

    def draw_debug(
        self,
        frame,
        center_x,
        center_y,
        target
    ):
        if target is not None:

            target_x, target_y, target_type = target

            if target_type == 'face':
                target_color = (0, 0, 255)

            elif target_type == 'hand':
                target_color = (0, 255, 0)

            else:
                target_color = (255, 255, 255)

            target_x = int(target_x)
            target_y = int(target_y)

            cv2.circle(
                frame,
                (target_x, target_y),
                10,
                target_color,
                -1
            )

            cv2.drawMarker(
                frame,
                (target_x, target_y),
                target_color,
                cv2.MARKER_CROSS,
                40,
                3
            )

            cv2.line(
                frame,
                (int(center_x), int(center_y)),
                (target_x, target_y),
                target_color,
                2
            )

            # ------------------------------------------------------------
            # Image center
            # ------------------------------------------------------------

            cv2.drawMarker(
                frame,
                (
                    int(center_x),
                    int(center_y)
                ),
                (255, 0, 0),
                cv2.MARKER_CROSS,
                30,
                2
            )


            # ------------------------------------------------------------
            # Status
            # ------------------------------------------------------------

            cv2.putText(
                frame,
                f'Target: {self.target_type}',
                (20, 30),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                target_color,
                2
            )

            cv2.putText(
                frame,
                f'Pan: {self.pan_angle:.1f} deg',
                (20, 60),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                (255, 255, 255),
                2
            )

            cv2.putText(
                frame,
                f'Tilt: {self.tilt_angle:.1f} deg',
                (20, 90),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                (255, 255, 255),
                2
            )
    
    # =================================================================
    # Shutdown
    # =================================================================

    def destroy_node(self):

        self.cap.release()

        cv2.destroyAllWindows()

        super().destroy_node()


def main(args=None):

    rclpy.init(args=args)

    node = PanTiltTracker()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()